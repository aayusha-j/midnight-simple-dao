# Copy to .env.preview and set exactly ONE of the two secrets below.
# The wallet is funded via the Preview faucet before `npm run deploy`.
# https://midnight-tmnight-preview.nethermind.dev/

# Set only one; delete the other.
MIDNIGHT_PREVIEW_MNEMONIC=replace-with-24-word-mnemonic
MIDNIGHT_PREVIEW_SEED=replace-with-a-64-char-hex-seed

# Hosted proof server for the Preview network (no local Docker required).
MIDNIGHT_PROOF_SERVER=https://proof-server.preview.midnight.network