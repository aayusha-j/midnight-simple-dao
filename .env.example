# Copy to frontend/.env.local.
# VITE_NETWORK selects the Midnight network the DApp Connector wallet must
# be connected to. Only `preview` is wired up out of the box.
VITE_NETWORK=preview

# Contract address, filled in after `npm run deploy -- --network preview`.
VITE_CONTRACT_ADDRESS=

# Public data provider (indexer) used to read live contract state.
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql

# Wallet used for proof generation + submission on the browser side. This is
# the DApp-provided proof provider; the wallet adapter selects it when the
# user connects through the Midnight DApp Connector.
VITE_PROOF_URL=https://proof-server.preview.midnight.network